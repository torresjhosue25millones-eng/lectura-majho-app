PORT=3001

# ── SMTP (correo de salida) ─────────────────────────────────────────────────
# Gmail: host=smtp.gmail.com, port=465 (SSL) o 587 (TLS)
# Usa una "Contraseña de aplicación" de Google, NO tu contraseña normal.
# Para generarla: myaccount.google.com → Seguridad → Contraseñas de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM_NAME=Método MAJHO
SMTP_FROM_EMAIL=tu-correo@gmail.com

# ── Claude AI (interpretaciones personalizadas) ─────────────────────────────
# Consigue tu clave en: console.anthropic.com
# Si no la configuras, el PDF usa interpretaciones estáticas (también válido)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx

# ── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
